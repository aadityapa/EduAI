# Database
DATABASE_URL="postgresql://eduai:eduai_dev@localhost:5433/eduai?schema=public"
# Optional: PgBouncer (docker compose --profile pooling) — use for app runtime under load
# DATABASE_URL="postgresql://eduai:eduai_dev@localhost:6432/eduai?schema=public&pgbouncer=true"
# DATABASE_DIRECT_URL="postgresql://eduai:eduai_dev@localhost:5433/eduai?schema=public"
# Optional read replica (falls back to primary when unset)
# DATABASE_READ_URL=""

# Redis
REDIS_URL="redis://localhost:6379"
# Curriculum cache TTL seconds (default 300)
# CURRICULUM_CACHE_TTL_SEC="300"
# BullMQ workers / async AI generation
# JOBS_ENABLED="true"
# AI_JOBS_ASYNC="false"
# JOBS_CONCURRENCY="2"
# Inter-service HTTP timeout (ms)
# HTTP_TIMEOUT_MS="5000"
# DB_QUERY_TIMEOUT_MS="5000"

# JWT / Auth
JWT_SECRET="change-me-in-production-use-32-chars-min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
AUTH_SECRET="change-me-authjs-secret-32-chars-min"

# Phase 9 — Security / DPDP
# Field-level encryption key (32 bytes base64 OR 64 hex chars). Required to encrypt PII in production.
# FIELD_ENCRYPTION_KEY=""
# Comma-separated hosts allowed for homework/OCR media URLs (SSRF allowlist)
# UPLOAD_URL_ALLOWLIST="eduai-uploads.s3.ap-south-1.amazonaws.com,cdn.eduai.local"
# Optional malware scan webhook (POST JSON metadata; do not send secrets)
# SCAN_WEBHOOK_URL=""
# Documented primary residency region (India)
DATA_RESIDENCY_REGION="ap-south-1"
# DATA_RESIDENCY_NOTES="Primary: AWS Mumbai (ap-south-1). Cross-region replication disabled by default."

# OAuth (stubs for Sprint 1)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Services
IDENTITY_SERVICE_URL="http://localhost:3001"
NEXT_PUBLIC_IDENTITY_SERVICE_URL="http://localhost:3001"
LEARNING_SERVICE_URL="http://localhost:3003"
NEXT_PUBLIC_LEARNING_SERVICE_URL="http://localhost:3003"
AI_SERVICE_URL="http://localhost:3004"
NEXT_PUBLIC_AI_SERVICE_URL="http://localhost:3004"
ERP_SERVICE_URL="http://localhost:3005"
NEXT_PUBLIC_ERP_SERVICE_URL="http://localhost:3005"
BILLING_SERVICE_URL="http://localhost:3006"
NEXT_PUBLIC_BILLING_SERVICE_URL="http://localhost:3006"
INTERNAL_API_KEY="dev-internal-key-change-in-production"

# Billing Providers (optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# AI Providers (optional — mock used when unset in development)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# Production: mock is refused unless AI_ALLOW_MOCK=true
AI_ALLOW_MOCK=""
AI_PREFERRED_PROVIDER="openai"
AI_CHEAP_MODEL="gpt-4o-mini"
AI_PREMIUM_MODEL="gpt-4o"
AI_GEMINI_CHEAP_MODEL="gemini-1.5-flash"
AI_GEMINI_PREMIUM_MODEL="gemini-1.5-pro"
AI_CACHE_ENABLED="true"
# Server-side AI usage billing rate (INR per 1k tokens) — never trust client amounts
AI_USAGE_RATE_PER_1K="0.5"

# Apps
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"
AUTH_URL="http://localhost:3000"
AUTH_URL_ADMIN="http://localhost:3002"

# Observability (Phase 10) — leave empty locally; never commit real DSNs
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_SDK_DISABLED="true"
# OTEL_SERVICE_NAMESPACE="eduai"
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="development"
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# NEXT_PUBLIC_SENTRY_DSN=""
# EXPO_PUBLIC_SENTRY_DSN=""
# LOG_LEVEL="info"
# HTTP_ACCESS_LOG="true"
# Feature flags (Phase 11): JSON object or FF_<NAME>=true|false
# FEATURE_FLAGS_JSON="{}"
# FF_ADMIN_ANALYTICS_V2="false"

# Mobile (Expo Metro — port 8081, separate from web)
# Run: pnpm dev:mobile

# Default tenant (local dev)
DEFAULT_TENANT_SLUG="demo"
